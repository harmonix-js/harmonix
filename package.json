{
  "name": "harmonix-framework",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonix-js/harmonix.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint --cache . && prettier -c .",
    "lint:fix": "eslint --cache --fix . && prettier -w .",
    "lint:knip": "knip",
    "harmonix": "node ./packages/cli/bin/cli.mjs",
    "play": "harmonix dev playground",
    "play:build": "harmonix build playground",
    "ci:version": "node ./scripts/version.ts",
    "ci:publish": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "resolutions": {
    "harmonix": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.3",
    "eslint": "^9.39.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "harmonix": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^5.73.3",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tinyexec": "^1.0.2",
    "turbo": "^2.6.3",
    "typescript-eslint": "^8.49.0"
  },
  "packageManager": "pnpm@10.25.0"
}
