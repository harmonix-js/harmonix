{
  "name": "harmonix-framework",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonix-js/harmonix.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run prepack",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "eslint --cache . && prettier -c .",
    "lint:fix": "eslint --cache --fix . && prettier -w .",
    "lint:knip": "knip",
    "harmonix": "node ./packages/cli/bin/cli.mjs",
    "play": "harmonix dev playground",
    "play:build": "harmonix build playground",
    "ci:version": "node ./scripts/version.ts",
    "ci:publish": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "resolutions": {
    "harmonix": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.36.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "harmonix": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^5.63.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "tinyexec": "^1.0.1",
    "turbo": "^2.5.8",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.2"
}
