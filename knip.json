{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/harmonix": {
      "entry": ["src/runtime/**/*.ts"]
    },
    "packages/cli": {
      "ignoreUnresolved": ["#harmonix-virtual/*"]
    },
    "playground": {
      "entry": ["commands/**", "events/**", "plugins/**"],
      "ignore": ["harmonix.config.*"]
    }
  }
}
